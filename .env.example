# Copy this file to .env and fill in your local values.

# Database used by the FastAPI backend and Alembic migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iris_db

# JWT signing secret. Use a long, random string.
SECRET_KEY=replace-me-with-a-long-random-string

# Optional, defaults to development.
APP_ENV=development

# Optional JWT settings.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional docker-compose settings if you want to override defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iris_db

# Optional for the Streamlit frontend when running locally.
API_BASE_URL=http://localhost:8000
